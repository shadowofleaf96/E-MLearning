    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^6.4.23",
    "@types/qrcode": "^1.5.6",
    "@types/stripe": "^8.0.417",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "express": "^5.2.1",
    "install": "^0.13.0",
    "nodemon": "^3.1.14",
    "npm": "^10.9.8",
