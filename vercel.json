{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs"
    },
    "code-runner-service": {
      "root": "code-runner-service",
      "framework": "express"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/((?!en|fr|ar|api|_next|images|locales|favicon\\.ico).*)",
      "destination": "/en/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
